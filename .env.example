# Hash SHA-256 du mot de passe admin. Génère le tien (voir README) — NE JAMAIS
# committer une vraie valeur ici, ce fichier est un template versionné dans un
# dépôt public.
# Exemple de génération : echo -n "TonMotDePasse" | shasum -a 256
ADMIN_PASSWORD_HASH=

# Secret de signature des sessions (32+ octets aléatoires). Génère le tien :
# openssl rand -hex 32 — NE JAMAIS committer une vraie valeur ici.
SESSION_SECRET=

# Token Vercel Blob — créé automatiquement quand tu attaches un Blob Store au projet sur Vercel.
# En local : récupère-le dans Vercel > Storage > ton store > .env.local
BLOB_READ_WRITE_TOKEN=

# Store Redis (Upstash, via Vercel Marketplace) — alimente le compteur
# d'apprenants (middleware.js). Optionnel : sans lui, le site fonctionne
# quand même, la ligne de preuve sociale reste simplement absente.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
